---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
---

<section id="about" class="about wrap" aria-labelledby="about-title">
  <Image
    class="portrait"
    src={portrait}
    alt="Yordan Mihalev"
    width={1100}
    widths={[480, 800, 1100]}
    sizes="(min-width: 900px) 40vw, 90vw"
    loading="lazy"
  />
  <div class="text">
    <h2 id="about-title">About</h2>
    <!-- TODO(client): replace with Yordan's own bio. -->
    <p class="lead">
      I design costumes for film and theatre. Every costume starts with research into the
      period, the character and how the actor needs to move, and ends with something that
      serves the story.
    </p>
    <p>
      I work closely with directors, actors and production teams, from the first sketch to the
      last fitting.
    </p>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding-block: clamp(4rem, 10vw, 9rem);
    border-top: 1px solid var(--line);
  }

  .portrait {
    width: 100%;
    filter: grayscale(1);
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  p {
    max-width: var(--measure);
    color: var(--grey);
  }

  p + p {
    margin-top: 1em;
  }

  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--paper);
  }

  @media (max-width: 899px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
