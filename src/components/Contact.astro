---
---

<section id="contact" class="section-padding">
  <div class="container-custom">
    <div class="w-full max-w-full sm:max-w-2xl md:max-w-3xl lg:max-w-4xl xl:max-w-5xl mx-auto animate-on-scroll">
      <h2 class="mb-5 text-center">Contact</h2>

      <div class="glass-panel rounded-md p-5 sm:p-6 md:p-8 lg:p-10">
        <form id="contact-form" class="space-y-4 md:space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-5">
            <div>
              <label for="name" class="block text-xs md:text-sm font-medium text-gray-400 mb-1 uppercase tracking-wider">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-3 py-2 md:px-4 md:py-3 bg-surface-900/60 border border-primary-500/20 rounded-md text-white text-sm md:text-base placeholder-gray-500 focus:ring-1 focus:ring-primary-400 focus:border-primary-400"
                required
              />
            </div>
            
            <div>
              <label for="email" class="block text-xs md:text-sm font-medium text-gray-400 mb-1 uppercase tracking-wider">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full px-3 py-2 md:px-4 md:py-3 bg-surface-900/60 border border-primary-500/20 rounded-md text-white text-sm md:text-base placeholder-gray-500 focus:ring-1 focus:ring-primary-400 focus:border-primary-400"
                required
              />
            </div>
          </div>
          
          <div>
            <label for="subject" class="block text-xs md:text-sm font-medium text-gray-400 mb-1 uppercase tracking-wider">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              class="w-full px-3 py-2 md:px-4 md:py-3 bg-surface-900/60 border border-primary-500/20 rounded-md text-white text-sm md:text-base placeholder-gray-500 focus:ring-1 focus:ring-primary-400 focus:border-primary-400"
              required
            />
          </div>
          
          <div>
            <label for="project-type" class="block text-xs md:text-sm font-medium text-gray-400 mb-1 uppercase tracking-wider">Project</label>
            <select
              id="project-type"
              name="project-type"
              class="w-full px-3 py-2 md:px-4 md:py-3 bg-surface-900/60 border border-primary-500/20 rounded-md text-white text-sm md:text-base focus:ring-1 focus:ring-primary-400 focus:border-primary-400"
            >
              <option value="film">Film</option>
              <option value="theater">Theater</option>
              <option value="fashion">Fashion</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="message" class="block text-xs md:text-sm font-medium text-gray-400 mb-1 uppercase tracking-wider">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-3 py-2 md:px-4 md:py-3 md:min-h-[160px] lg:min-h-[200px] bg-surface-900/60 border border-primary-500/20 rounded-md text-white text-sm md:text-base placeholder-gray-500 focus:ring-1 focus:ring-primary-400 focus:border-primary-400"
              required
            ></textarea>
          </div>
          
          <button type="submit" class="w-full btn-primary md:text-base md:py-3">
            Send
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    emailjs.init("4odIy3ek0pUAxmrLa");
    
    const form = document.getElementById('contact-form');
    const submitButton = form.querySelector('button[type="submit"]');
    
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      submitButton.disabled = true;
      submitButton.textContent = 'Sending...';
      
      const templateParams = {
        name: form.name.value,
        email: form.email.value,
        subject: form.subject.value,
        project_type: form['project-type'].value,
        message: form.message.value
      };
      
      emailjs.send(
        'service_xnt843p',
        'template_np3hg0l',
        templateParams
      )
      .then(() => {
        form.reset();
        submitButton.disabled = false;
        submitButton.textContent = 'Send';
        alert('Thank you for your message! I will get back to you soon.');
      })
      .catch(error => {
        console.error('Error sending email:', error);
        submitButton.disabled = false;
        submitButton.textContent = 'Send';
        alert('Sorry, there was an error sending your message. Please try again later.');
      });
    });
  });
</script>
