---
const email = 'mihalevyordan@gmail.com';
const phone = { display: '+359 897 857 153', href: 'tel:+359897857153' };
const instagram = {
  handle: '@yordan_mihalev',
  href: 'https://www.instagram.com/yordan_mihalev',
};
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <div class="direct">
    <h2 id="contact-title">Contact</h2>
    <a class="email" href={`mailto:${email}`}>{email}</a>
    <ul>
      <li><a href={phone.href}>{phone.display}</a></li>
      <li><a href={instagram.href} rel="noopener" target="_blank">Instagram {instagram.handle}</a></li>
    </ul>
  </div>

  <form class="form" novalidate>
    <p class="intro">Or write here and the message goes straight to Yordan's inbox.</p>
    <label>
      Name
      <input name="name" autocomplete="name" required />
    </label>
    <label>
      Email
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      Message
      <textarea name="message" rows="5" required></textarea>
    </label>
    <button type="submit">Send message</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
</section>

<script>
  import emailjs from '@emailjs/browser';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('.contact .form');
    if (!form) return;
    const button = form.querySelector('button')!;
    const status = form.querySelector('.status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = 'Fill in your name, a valid email address and a message.';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const data = new FormData(form);
      button.disabled = true;
      button.textContent = 'Sending…';
      status.textContent = '';

      try {
        await emailjs.send(
          'service_xnt843p',
          'template_np3hg0l',
          {
            name: data.get('name'),
            email: data.get('email'),
            subject: 'Message from the website',
            project_type: 'Not specified',
            message: data.get('message'),
          },
          { publicKey: '4odIy3ek0pUAxmrLa' },
        );
        form.reset();
        status.textContent = 'Message sent. Yordan will reply by email.';
      } catch {
        status.textContent =
          'Message not sent. Check your connection and try again, or email mihalevyordan@gmail.com.';
      } finally {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 6rem);
    padding-block: clamp(4rem, 10vw, 9rem);
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: var(--step-3);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .email {
    display: inline-block;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.6vw, 2.25rem);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
  }

  ul {
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--step-1);
  }

  li + li {
    margin-top: 0.4rem;
  }

  .form {
    display: grid;
    gap: 1.25rem;
    max-width: 32rem;
    align-self: end;
  }

  .intro {
    color: var(--grey);
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--grey);
    border-radius: 0;
    background: none;
    font-size: var(--step-0);
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--signal);
    box-shadow: 0 1px 0 var(--signal);
  }

  button {
    justify-self: start;
    padding: 0.9rem 1.75rem;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: var(--signal);
    color: var(--paper);
  }

  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status:empty {
    display: none;
  }

  @media (max-width: 899px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
