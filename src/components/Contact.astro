---
const email = 'mihalevyordan@gmail.com';
const phone = { display: '+359 897 857 153', href: 'tel:+359897857153' };
const instagram = {
  handle: 'yordan_mihalev',
  href: 'https://www.instagram.com/yordan_mihalev',
};
---

<section id="contact" class="contact wrap" aria-labelledby="contact-title">
  <h2 id="contact-title" class="visually-hidden">Contact</h2>

  <form class="form" novalidate>
    <p class="intro">Write here and the message goes straight to Yordan's inbox.</p>
    <label>
      Name
      <input name="name" autocomplete="name" required />
    </label>
    <label>
      Email
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="message">
      Message
      <textarea name="message" rows="5" required></textarea>
    </label>
    <button type="submit">Send message</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>

  <ul class="direct">
    <li>
      <a href={`mailto:${email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1.5" />
          <path d="m3.5 6 8.5 7 8.5-7" />
        </svg>
        <span class="visually-hidden">Email: </span>{email}
      </a>
    </li>
    <li>
      <a href={phone.href}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8.5 3.5 6 3a2 2 0 0 0-2.3 1.7c-.5 8 6.6 15 14.6 14.6A2 2 0 0 0 20 17l-.5-2.5-4-1.5-2 2a12 12 0 0 1-5.5-5.5l2-2z" />
        </svg>
        <span class="visually-hidden">Phone: </span>{phone.display}
      </a>
    </li>
    <li>
      <a href={instagram.href} rel="noopener" target="_blank">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle class="dot" cx="17.3" cy="6.7" r="0.6" />
        </svg>
        <span class="visually-hidden">Instagram: </span>{instagram.handle}
      </a>
    </li>
  </ul>
</section>

<script>
  import emailjs from '@emailjs/browser';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('.contact .form');
    if (!form) return;
    const button = form.querySelector('button')!;
    const status = form.querySelector('.status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        status.textContent = 'Fill in your name, a valid email address and a message.';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const data = new FormData(form);
      button.disabled = true;
      button.textContent = 'Sending…';
      status.textContent = '';

      try {
        await emailjs.send(
          'service_xnt843p',
          'template_np3hg0l',
          {
            name: data.get('name'),
            email: data.get('email'),
            subject: 'Message from the website',
            project_type: 'Not specified',
            message: data.get('message'),
          },
          { publicKey: '4odIy3ek0pUAxmrLa' },
        );
        form.reset();
        status.textContent = 'Message sent. Yordan will reply by email.';
      } catch {
        status.textContent =
          'Message not sent. Check your connection and try again, or email mihalevyordan@gmail.com.';
      } finally {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  });
</script>

<style>
  .contact {
    padding-block: clamp(4rem, 10vw, 9rem);
    border-top: 1px solid var(--line);
  }

  /* The form runs the full width: name and email side by side, the message under them. */
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
  }

  .intro,
  .message,
  .status {
    grid-column: 1 / -1;
  }

  .intro {
    color: var(--grey);
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--grey);
    border-radius: 0;
    background: none;
    font-size: var(--step-0);
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--signal);
    box-shadow: 0 1px 0 var(--signal);
  }

  button {
    justify-self: start;
    padding: 0.9rem 1.75rem;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: var(--signal);
    color: var(--paper);
  }

  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status:empty {
    display: none;
  }

  /* Email, phone and Instagram in one row, all the same size, each behind a white icon. */
  .direct {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 2rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: var(--step-1);
    font-weight: 500;
  }

  .direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .direct a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .direct svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: var(--paper);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .direct .dot {
    fill: var(--paper);
  }

  @media (max-width: 899px) {
    .form {
      grid-template-columns: 1fr;
    }

    .direct {
      flex-direction: column;
      font-size: var(--step-0);
    }
  }
</style>
