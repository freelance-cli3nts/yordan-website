---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { name: "Home", url: "#home" },
  { name: "Costume Design", url: "#costume-design" },
  { name: "On-set", url: "#on-set" },
  { name: "Contact", url: "#contact" },
];

const instagramUrl = "https://www.instagram.com/yordan_mihalev?igsh=c2x2eW52dXcyb3Fo&utm_source=qr";
---

<footer class="border-t border-primary-500/15 pt-8 pb-6 mt-2">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <a href="#home" class="text-lg font-serif font-bold tracking-tight">
        <span class="text-primary-400">YORDANS</span>
        <span class="text-white">DESIGNS</span>
      </a>
      
      <nav class="flex flex-wrap gap-x-5 gap-y-2">
        {footerLinks.map(link => (
          <a 
            href={link.url} 
            class="text-sm text-gray-400 hover:text-primary-300 transition-colors"
          >
            {link.name}
          </a>
        ))}
      </nav>
      
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-400">
        <a href="mailto:mihalevyordan@gmail.com" class="hover:text-primary-300 transition-colors">
          mihalevyordan@gmail.com
        </a>
        <span class="hidden sm:inline text-primary-500/30" aria-hidden="true">|</span>
        <a href="tel:+359897857153" class="hover:text-primary-300 transition-colors">
          +359 897 857 153
        </a>
        <a
          href={instagramUrl}
          aria-label="Instagram"
          class="text-primary-300 hover:text-primary-200 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
    
    <div class="pt-4 border-t border-primary-500/10 text-center text-xs text-gray-500">
      <p>&copy; {currentYear} Yordans Designs</p>
    </div>
  </div>
</footer>
