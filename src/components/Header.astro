---
import { url } from '../lib/url';

const navItems = [
  { name: 'Work', href: url('#work') },
  { name: 'About', href: url('#about') },
  { name: 'Contact', href: url('#contact') },
];
---

<nav class="nav" aria-label="Main">
  <ul>
    {navItems.map((item) => (
      <li><a href={item.href}>{item.name}</a></li>
    ))}
  </ul>
</nav>

<style>
  /* Desktop: a vertical list in the space right of "Yordan". It runs from the top of the N
     to the middle of the N, right-aligned with the end of "Mihalev", and scrolls away with the
     name (pinned, it would run over the right-aligned theatre column).
     The offsets are Unbounded's metrics at the hero's line height: the cap top sits 0.055em
     below the line box and the cap is 0.75em tall. */
  .nav {
    --cap-top: calc(var(--hero-top) + var(--name-size) * 0.055);
    --cap-middle: calc(var(--hero-top) + var(--name-size) * 0.43);
    position: absolute;
    z-index: 50;
    top: var(--cap-top);
    right: var(--gutter);
    height: calc(var(--cap-middle) - var(--cap-top));
  }

  ul {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    height: 100%;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    font-size: clamp(0.8rem, var(--name-size) * 0.085, 1.25rem);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    /* Trim to the letters, so Work starts at the top of the N and Contact ends at its middle. */
    text-box: trim-both cap alphabetic;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
  }

  /* Phones: a bar at the bottom of the screen. */
  @media (max-width: 899px) {
    .nav {
      position: fixed;
      top: auto;
      right: auto;
      bottom: max(1rem, env(safe-area-inset-bottom));
      left: 50%;
      height: auto;
      transform: translateX(-50%);
    }

    ul {
      flex-direction: row;
      gap: 0.25rem;
      padding: 0.3rem;
      border: 1px solid rgb(255 255 255 / 0.25);
      border-radius: 999px;
      background: rgb(0 0 0 / 0.75);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }

    a {
      padding: 0.7rem 1.1rem;
      font-size: var(--step--1);
      text-box: normal;
    }
  }
</style>
