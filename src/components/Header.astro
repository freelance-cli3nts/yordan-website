---
import { url } from '../lib/url';

const isHome = Astro.url.pathname === url();

const navItems = [
  { name: 'Work', href: url('#work') },
  { name: 'About', href: url('#about') },
  { name: 'Contact', href: url('#contact') },
];
---

<header class="header wrap" data-home={isHome ? '' : undefined}>
  <a class="mark" href={url()}>Yordan Mihalev</a>
  <nav aria-label="Main">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.name}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // On the home page the small name stays hidden until the big one in the hero scrolls away.
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('.header');
    const name = document.querySelector('.hero-name');
    if (!header || !name) return;
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-show-mark', !entry.isIntersecting);
    }).observe(name);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    background: var(--ink);
  }

  .mark {
    font-family: var(--display);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.3s var(--ease);
  }

  .header[data-home]:not([data-show-mark]) .mark {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease), visibility 0s 0.3s;
  }

  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
  }
</style>
