---
import { getImage } from 'astro:assets';
import heroPoster from '../assets/hero-poster.jpg';
import { url } from '../lib/url';

const poster = await getImage({ src: heroPoster, width: 1600, format: 'webp' });
---

<section class="hero" aria-label="Introduction">
  <div class="name-water">
    <h1 class="hero-name wrap">
      <span>Yordan</span>
      <span>Mihalev</span>
    </h1>

    <div class="reflection wrap" aria-hidden="true">
      <div class="water">
        <div class="reflection-text">Mihalev</div>
      </div>
    </div>

    <canvas aria-hidden="true"></canvas>
  </div>

  <p class="hero-line wrap">Costume designer for film and theatre</p>

  <div class="hero-film">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={poster.src}
      aria-hidden="true"
    >
      <source src={url('hero-mobile.mp4')} type="video/mp4" media="(max-aspect-ratio: 3/4)" />
      <source src={url('hero.mp4')} type="video/mp4" />
    </video>
    <button class="film-toggle" type="button" aria-pressed="false" aria-label="Pause video">
      <span class="ring" aria-hidden="true"></span>
      <span class="ring" aria-hidden="true"></span>
      <span class="ring" aria-hidden="true"></span>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14M16 5v14" />
      </svg>
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5v13l10.5-6.5z" />
      </svg>
    </button>
  </div>

  <svg class="filters" aria-hidden="true" focusable="false">
    <filter id="water" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.0006 0.06"
        numOctaves="1"
        seed="4"
        result="noise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="16"
        xChannelSelector="R"
        yChannelSelector="B"
        result="rippled"
      />
      <feGaussianBlur in="rippled" stdDeviation="0.5 1.2" />
    </filter>
  </svg>
</section>

<script>
  import { Ripples } from '../lib/ripples';

  let stop: (() => void) | undefined;

  // Draws the name exactly where the page lays it out, plus its reflection:
  // "Mihalev" flipped at its baseline, squashed to 45% height and fading out.
  function paintName(block: HTMLElement, width: number, height: number, ratio: number) {
    const name = block.querySelector<HTMLElement>('.hero-name')!;
    const water = block.querySelector<HTMLElement>('.water')!;
    const style = getComputedStyle(name);
    const size = parseFloat(style.fontSize);
    const origin = block.getBoundingClientRect();
    const font = `800 ${size}px ${style.fontFamily}`;
    const spacing = size * -0.035;

    const write = (ctx: CanvasRenderingContext2D, word: string) => {
      ctx.font = font;
      ctx.fillStyle = '#fff';
      if ('letterSpacing' in ctx) {
        ctx.letterSpacing = `${spacing}px`;
        ctx.fillText(word, 0, 0);
        return;
      }
      let x = 0;
      for (const letter of word) {
        ctx.fillText(letter, x, 0);
        x += ctx.measureText(letter).width + spacing;
      }
    };

    const canvas = document.createElement('canvas');
    canvas.width = Math.round(width * ratio);
    canvas.height = Math.round(height * ratio);
    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // The baseline sits 0.805em down each line box (Unbounded at line-height 0.86).
    const lines = [...name.querySelectorAll('span')];
    for (const line of lines) {
      const box = line.getBoundingClientRect();
      const x = box.left - origin.left;
      const y = box.top - origin.top + size * 0.805;
      ctx.setTransform(ratio, 0, 0, ratio, x * ratio, y * ratio);
      write(ctx, line.textContent!.trim().toUpperCase());
    }

    const pool = water.getBoundingClientRect();
    const last = lines[lines.length - 1].getBoundingClientRect();
    const mirror = document.createElement('canvas');
    mirror.width = Math.round(pool.width * ratio);
    mirror.height = Math.round(pool.height * ratio);
    const m = mirror.getContext('2d')!;
    m.setTransform(ratio, 0, 0, -0.45 * ratio, (last.left - pool.left) * ratio, 0);
    write(m, lines[lines.length - 1].textContent!.trim().toUpperCase());
    m.setTransform(1, 0, 0, 1, 0, 0);
    m.globalCompositeOperation = 'destination-in';
    const fade = m.createLinearGradient(0, 0, 0, mirror.height);
    fade.addColorStop(0, 'rgb(0 0 0 / 0.5)');
    fade.addColorStop(0.92, 'rgb(0 0 0 / 0)');
    m.fillStyle = fade;
    m.fillRect(0, 0, mirror.width, mirror.height);

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.drawImage(mirror, (pool.left - origin.left) * ratio, (pool.top - origin.top) * ratio);
    return canvas;
  }

  document.addEventListener('astro:page-load', () => {
    stop?.();
    stop = undefined;

    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;

    const video = hero.querySelector('video')!;
    const toggle = hero.querySelector<HTMLButtonElement>('.film-toggle')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setPlaying = (playing: boolean) => {
      if (playing) video.play().catch(() => {});
      else video.pause();
      toggle.setAttribute('aria-pressed', String(!playing));
      toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    };
    if (reduceMotion) setPlaying(false);
    toggle.addEventListener('click', () => setPlaying(video.paused));

    // The water: the whole name and its reflection ripple under the pointer or finger.
    // Without WebGL, or with reduced motion, the page's own text and still reflection stay.
    if (reduceMotion) return;
    const block = hero.querySelector<HTMLElement>('.name-water')!;
    const name = block.querySelector<HTMLElement>('.hero-name')!;
    let canvas = block.querySelector('canvas')!;
    let ripples: Ripples | undefined;
    let frame = 0;
    let visible = true;
    let stopped = false;
    // Ripples and their bend are sized to the name: as set for a large screen, smaller on a phone.
    const scale = () => parseFloat(getComputedStyle(name).fontSize) / 224;

    const tick = () => {
      ripples?.frame();
      frame = visible ? requestAnimationFrame(tick) : 0;
    };

    const build = async () => {
      await document.fonts.load(`800 1em ${getComputedStyle(name).fontFamily}`);
      if (stopped) return;
      ripples?.destroy();
      const { width, height } = block.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      // A canvas whose WebGL context was lost can't get a new one, so start from a fresh one.
      const fresh = canvas.cloneNode() as HTMLCanvasElement;
      canvas.replaceWith(fresh);
      canvas = fresh;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      try {
        ripples = Ripples.create(canvas, paintName(block, width, height, ratio), {
          perturbance: Math.max(4, 8 * scale()),
        });
      } catch {
        ripples = undefined;
      }
      block.toggleAttribute('data-live', !!ripples);
      if (ripples && !frame) frame = requestAnimationFrame(tick);
    };

    let lastWidth = 0;
    const resize = new ResizeObserver(([entry]) => {
      const width = Math.round(entry.contentRect.width);
      if (width === lastWidth) return;
      lastWidth = width;
      build();
    });
    resize.observe(block);

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && ripples && !frame) frame = requestAnimationFrame(tick);
    });
    observer.observe(block);

    const dropAt = (point: { clientX: number; clientY: number }, strength: number) => {
      if (!ripples) return;
      const box = canvas.getBoundingClientRect();
      const x = (point.clientX - box.left) / box.width;
      const y = (point.clientY - box.top) / box.height;
      if (x < 0 || x > 1 || y < 0 || y > 1) return;
      ripples.drop(x, y, Math.max(6, 20 * scale()), strength);
    };

    // Mouse and pen through pointer events. Touch through touch events, because once a
    // swipe turns into a scroll the browser cancels its pointer events but touchmove goes on.
    const onMove = (event: PointerEvent) => {
      if (event.pointerType !== 'touch') dropAt(event, 0.01);
    };
    const onDown = (event: PointerEvent) => {
      if (event.pointerType !== 'touch') dropAt(event, 0.14);
    };
    const onTouchStart = (event: TouchEvent) => {
      for (const touch of event.changedTouches) dropAt(touch, 0.14);
    };
    const onTouchMove = (event: TouchEvent) => {
      for (const touch of event.changedTouches) dropAt(touch, 0.04);
    };
    hero.addEventListener('pointermove', onMove);
    hero.addEventListener('pointerdown', onDown);
    hero.addEventListener('touchstart', onTouchStart, { passive: true });
    hero.addEventListener('touchmove', onTouchMove, { passive: true });

    // A drop now and then, so the water is alive without a pointer. Touch screens get
    // more and stronger drops, since nothing hovers there.
    const touchScreen = window.matchMedia('(hover: none)').matches;
    const rain = window.setInterval(
      () => {
        if (!visible) return;
        const radius = Math.max(5, 14 * scale());
        ripples?.drop(Math.random(), Math.random(), radius, touchScreen ? 0.1 : 0.05);
      },
      touchScreen ? 1100 : 2400,
    );

    stop = () => {
      stopped = true;
      cancelAnimationFrame(frame);
      clearInterval(rain);
      resize.disconnect();
      observer.disconnect();
      hero.removeEventListener('pointermove', onMove);
      hero.removeEventListener('pointerdown', onDown);
      hero.removeEventListener('touchstart', onTouchStart);
      hero.removeEventListener('touchmove', onTouchMove);
      ripples?.destroy();
    };
  });
</script>

<style>
  /* The name is sized so "Mihalev" runs exactly from gutter to gutter. */
  .hero {
    --name-size: min(calc((100cqi - 2 * var(--gutter)) / 5.86), 24rem);
    container-type: inline-size;
    padding-top: var(--hero-top);
  }

  .name-water {
    position: relative;
  }

  .hero-name,
  .reflection-text {
    font-family: var(--display);
    font-size: var(--name-size);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .hero-name span {
    display: block;
  }

  /* The reflection is "Mihalev" flipped at its baseline and squashed to 45% height,
     so it reads as water seen at an angle. The baseline sits 0.805em down the line box. */
  .reflection {
    pointer-events: none;
    user-select: none;
  }

  .water {
    height: calc(var(--name-size) * 0.38);
    overflow: hidden;
    margin-top: calc(var(--name-size) * -0.02);
    -webkit-mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.5), transparent 92%);
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.5), transparent 92%);
  }

  .reflection-text {
    transform-origin: 0 0.805em;
    transform: translateY(-0.805em) scaleY(-0.45);
    color: var(--paper);
    filter: url(#water);
  }

  /* With WebGL running, the canvas draws the name and reflection with their ripples.
     The heading stays in the page, transparent, for screen readers and search. */
  .name-water canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }

  .name-water[data-live] canvas {
    opacity: 1;
  }

  .name-water[data-live] .hero-name {
    color: transparent;
  }

  .name-water[data-live] .water {
    visibility: hidden;
  }

  .hero-line {
    margin-top: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--signal);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .hero-film {
    position: relative;
  }

  .hero-film video {
    width: 100%;
    aspect-ratio: 1998 / 1080;
    object-fit: cover;
    background: var(--line);
  }

  @media (max-aspect-ratio: 3/4) {
    .hero-film video {
      aspect-ratio: 9 / 16;
      max-height: 85svh;
    }
  }

  /* A round button in the middle of the film, with rings spreading inside it like a drop
     in water. The rings stop while the film is paused. */
  .film-toggle {
    --size: 5.5rem;
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .film-toggle:hover {
    border-color: var(--signal);
    background: rgb(225 18 31 / 0.35);
  }

  .film-toggle > * {
    grid-area: 1 / 1;
  }

  .ring {
    width: 100%;
    height: 100%;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    opacity: 0;
    animation: ripple 3s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
  }

  .ring:nth-child(2) {
    animation-delay: 1s;
  }

  .ring:nth-child(3) {
    animation-delay: 2s;
  }

  @keyframes ripple {
    from {
      transform: scale(0.1);
      opacity: 0.9;
    }
    to {
      transform: scale(1);
      opacity: 0;
    }
  }

  .film-toggle[aria-pressed='true'] .ring {
    animation-play-state: paused;
    visibility: hidden;
  }

  .film-toggle svg {
    position: relative;
    width: 1.75rem;
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-play {
    fill: var(--paper) !important;
  }

  .film-toggle[aria-pressed='false'] .icon-play,
  .film-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }

  /* Phones: smaller, in the top right corner of the film. */
  @media (max-width: 899px) {
    .film-toggle {
      --size: 3.5rem;
      top: 1rem;
      right: var(--gutter);
      left: auto;
      transform: none;
    }

    .film-toggle svg {
      width: 1.25rem;
    }
  }

  .filters {
    position: absolute;
    width: 0;
    height: 0;
  }
</style>
