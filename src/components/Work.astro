---
import { Image } from 'astro:assets';
import { columns, projectsIn, type Column } from '../data/projects';
import { url } from '../lib/url';

// Shown in the film column until the client sends film material.
const filmPlaceholders = 3;

const order: Column[] = ['film', 'theatre'];
// On phones only one column shows at a time; open on the first one that has real projects.
const firstShown = order.find((column) => projectsIn(column).length > 0) ?? order[0];
// Each column's cards leave toward its own side of the page.
const sideOf: Record<Column, 'left' | 'right'> = { film: 'left', theatre: 'right' };
---

<section id="work" class="work wrap" aria-labelledby="work-title">
  <h2 id="work-title" class="visually-hidden">Work</h2>

  <div class="switch" role="tablist" aria-label="Choose a column">
    {order.map((column) => (
      <button
        type="button"
        role="tab"
        id={`tab-${column}`}
        aria-controls={`column-${column}`}
        aria-selected={column === firstShown ? 'true' : 'false'}
        data-column={column}
      >
        {columns[column].title}
      </button>
    ))}
  </div>

  <div class="columns">
    {order.map((column) => {
      const projects = projectsIn(column);
      const count = projects.length || (column === 'film' ? filmPlaceholders : 0);
      return (
        <section
          class="column"
          id={`column-${column}`}
          data-column={column}
          data-active={column === firstShown ? '' : undefined}
          role="tabpanel"
          aria-labelledby={`tab-${column}`}
        >
          <header class="column-head">
            <h3>{columns[column].title}</h3>
            <p>{columns[column].description}</p>
          </header>

          <div class="deck" data-side={sideOf[column]}>
            <ol class="stack">
              {projects.map((project, pos) => (
                <li class="card" style={`--pos: ${pos}`} inert={pos > 0}>
                  <a
                    href={url(`work/${project.slug}/`)}
                    data-slide={sideOf[column]}
                    aria-label={`${project.title}, open project`}
                  >
                    <Image
                      src={project.cover}
                      alt=""
                      width={1200}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 900px) 45vw, 90vw"
                      loading="lazy"
                      transition:name={`cover-${project.slug}`}
                    />
                  </a>
                  <div class="caption">
                    <h4>{project.title}</h4>
                    {project.subtitle && <p>{project.subtitle}</p>}
                  </div>
                </li>
              ))}
              {!projects.length &&
                Array.from({ length: count }, (_, pos) => (
                  <li class="card is-placeholder" style={`--pos: ${pos}`} inert={pos > 0}>
                    <div class="frame" />
                    <div class="caption">
                      <h4>Film project {pos + 1}</h4>
                      <p>Production, studio and year</p>
                    </div>
                  </li>
                ))}
            </ol>

            {count > 1 && (
              <div class="controls">
                <button type="button" class="next" aria-label="Next project">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={sideOf[column] === 'left' ? 'M15 5 8 12l7 7' : 'm9 5 7 7-7 7'} />
                  </svg>
                </button>
                <input
                  class="slider"
                  type="range"
                  min="1"
                  max={count}
                  step="1"
                  value="1"
                  aria-label={`${columns[column].title}: project`}
                />
                <p aria-live="polite"><span class="current">1</span> of {count}</p>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
</section>

<script>
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cards turn like pages, hinged on the column's outer edge: film turns to the left,
  // theatre to the right. Going forward the top card turns away and tucks in at the back;
  // going back the previous card turns in on top. The one button only goes forward and
  // starts over after the last card. On phones a slider and swipes go both ways.
  function setUpDeck(deck: HTMLElement) {
    const cards = [...deck.querySelectorAll<HTMLElement>('.card')];
    const current = deck.querySelector('.current');
    const slider = deck.querySelector<HTMLInputElement>('.slider');
    if (cards.length < 2) return;
    const side = deck.dataset.side === 'left' ? -1 : 1;
    const turned = `rotateY(${side * 90}deg)`;
    let first = 0;
    let target = 0;
    let running = false;

    const place = () => {
      cards.forEach((card, i) => {
        const pos = (i - first + cards.length) % cards.length;
        card.inert = pos > 0;
        card.style.setProperty('--pos', String(pos));
      });
      if (current) current.textContent = String(first + 1);
      if (slider) slider.value = String(first + 1);
    };

    const forward = async (duration: number) => {
      const leaving = cards[first];
      first = (first + 1) % cards.length;
      leaving.classList.add('is-turning');
      place();
      if (!reduceMotion()) {
        await leaving.animate([{ transform: 'none' }, { transform: turned }], {
          duration,
          easing: 'cubic-bezier(0.55, 0, 0.75, 0.4)',
        }).finished;
      }
      leaving.classList.remove('is-turning');
    };

    const back = async (duration: number) => {
      first = (first - 1 + cards.length) % cards.length;
      const entering = cards[first];
      entering.classList.add('is-turning');
      place();
      if (!reduceMotion()) {
        await entering.animate([{ transform: turned }, { transform: 'none' }], {
          duration,
          easing: 'cubic-bezier(0.25, 0.6, 0.45, 1)',
        }).finished;
      }
      entering.classList.remove('is-turning');
    };

    // Steps one card at a time toward `target`, faster when the slider jumps several.
    const run = async () => {
      if (running) return;
      running = true;
      while (first !== target) {
        const ahead = (target - first + cards.length) % cards.length;
        const steps = Math.min(ahead, cards.length - ahead);
        const duration = steps > 1 ? 260 : 480;
        if (ahead <= cards.length - ahead) await forward(duration);
        else await back(duration);
      }
      running = false;
    };

    const go = (index: number) => {
      target = (index + cards.length) % cards.length;
      run();
    };

    deck.querySelector('.next')?.addEventListener('click', () => go(target + 1));

    // The slider never wraps: moving it left always turns pages back.
    slider?.addEventListener('input', async () => {
      target = Number(slider.value) - 1;
      if (running) return;
      running = true;
      while (first !== target) {
        const duration = Math.abs(target - first) > 1 ? 260 : 480;
        if (target > first) await forward(duration);
        else await back(duration);
      }
      running = false;
    });

    deck.addEventListener('keydown', (event) => {
      if (event.target === slider) return;
      if (event.key === 'ArrowRight') go(target + 1);
      if (event.key === 'ArrowLeft') go(target - 1);
    });

    // A swipe toward the column's side turns forward, the other way turns back.
    let startX: number | undefined;
    const stack = deck.querySelector<HTMLElement>('.stack')!;
    stack.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') startX = event.clientX;
    });
    stack.addEventListener('pointerup', (event) => {
      if (startX === undefined) return;
      const dx = event.clientX - startX;
      startX = undefined;
      if (Math.abs(dx) > 50) go(target + (Math.sign(dx) === side ? 1 : -1));
    });
  }

  function setUpSwitch(work: HTMLElement) {
    const tabs = [...work.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...work.querySelectorAll<HTMLElement>('.column')];
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((panel) =>
          panel.toggleAttribute('data-active', panel.dataset.column === tab.dataset.column),
        );
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    const work = document.querySelector<HTMLElement>('.work');
    if (!work) return;
    work.querySelectorAll<HTMLElement>('.deck').forEach(setUpDeck);
    setUpSwitch(work);
  });
</script>

<style>
  .work {
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  /* The two decks fill the page from gutter to gutter and meet in the middle, a narrow gap apart. */
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    align-items: start;
  }

  .column-head {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .column-head h3 {
    font-size: var(--step-2);
  }

  .column-head p {
    margin-top: 0.5rem;
    color: var(--grey);
  }

  /* The theatre column sits on the right and reads right-aligned, mirroring film. */
  .column[data-column='theatre'] .column-head {
    text-align: right;
  }

  .deck {
    touch-action: pan-y;
  }

  /* Every card sits exactly on the others, so the deck looks like one card; --pos 0 is on top. */
  .stack {
    display: grid;
    padding: 0;
    list-style: none;
    perspective: 2400px;
  }

  .card {
    grid-area: 1 / 1;
    z-index: calc(10 - var(--pos));
    background: var(--ink);
    backface-visibility: hidden;
  }

  .deck[data-side='left'] .card {
    transform-origin: left center;
  }

  .deck[data-side='right'] .card {
    transform-origin: right center;
  }

  .card[inert] .caption {
    visibility: hidden;
  }

  .card.is-turning {
    z-index: 20;
  }

  .card.is-turning .caption {
    visibility: visible;
  }

  .card a {
    display: block;
  }

  /* 4:5, but never so tall that the caption and button drop below the window:
     the card keeps its width and the photo is cropped instead. */
  .card img,
  .frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - 15rem);
    object-fit: cover;
    background: var(--line);
  }

  .frame {
    border: 1px dashed #444;
  }

  .caption {
    padding-top: 1rem;
  }

  .caption h4 {
    font-size: var(--step-1);
  }

  .caption p {
    margin-top: 0.25rem;
    color: var(--grey);
  }

  .deck[data-side='right'] .caption {
    text-align: right;
  }

  /* One big button, centred under the deck, with the count below it. */
  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    color: var(--grey);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .next {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid var(--paper);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .next:hover {
    border-color: var(--signal);
    background: var(--signal);
  }

  .next svg {
    width: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
  }

  .slider {
    display: none;
  }

  .switch {
    display: none;
  }

  @media (max-width: 899px) {
    .work {
      padding-top: 2rem;
    }

    .columns {
      grid-template-columns: 1fr;
    }

    .column:not([data-active]) {
      display: none;
    }

    .column-head h3 {
      display: none;
    }

    /* Phones also have the tabs above and the nav bar below. */
    .card img,
    .frame {
      max-height: calc(100svh - 19rem);
    }

    .column[data-column='theatre'] .column-head,
    .deck[data-side='right'] .caption {
      text-align: left;
    }

    /* Phones: a slider in place of the button, turning pages both ways. */
    .next {
      display: none;
    }

    .controls {
      flex-direction: row;
      gap: 1rem;
    }

    .slider {
      display: block;
      flex: 1;
      height: 2.75rem;
      margin: 0;
      background: none;
      accent-color: var(--paper);
      cursor: pointer;
      appearance: none;
    }

    .slider::-webkit-slider-runnable-track {
      height: 2px;
      background: var(--grey);
    }

    .slider::-moz-range-track {
      height: 2px;
      background: var(--grey);
    }

    .slider::-webkit-slider-thumb {
      width: 1.5rem;
      height: 1.5rem;
      margin-top: calc(-0.75rem + 1px);
      border: 0;
      border-radius: 50%;
      background: var(--paper);
      appearance: none;
    }

    .slider::-moz-range-thumb {
      width: 1.5rem;
      height: 1.5rem;
      border: 0;
      border-radius: 50%;
      background: var(--paper);
    }

    .switch {
      position: sticky;
      top: 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 1.5rem;
      background: var(--ink);
      border: 1px solid var(--paper);
    }

    .switch button {
      padding: 0.75rem 0.5rem;
      border: 0;
      background: none;
      font-size: var(--step--1);
      font-weight: 700;
      cursor: pointer;
    }

    .switch [aria-selected='true'] {
      background: var(--paper);
      color: var(--ink);
    }
  }
</style>
