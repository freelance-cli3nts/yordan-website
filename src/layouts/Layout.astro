---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import heroPoster from '../assets/hero-poster.jpg';
import { url } from '../lib/url';
import type { Column } from '../data/projects';

export interface Props {
  title: string;
  description?: string;
  /** Set on project pages so "back" slides the right way. */
  column?: Column;
}

const {
  title,
  description = 'Yordan Mihalev, costume designer for film and theatre.',
  column,
} = Astro.props;

const ogImage = await getImage({ src: heroPoster, width: 1200, format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-column={column}>
  <head>
    <meta charset="UTF-8" />
    <!-- resizes-content: on Android the keyboard shrinks the page instead of covering it. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <script>
      // Pick the slide direction for the page transition:
      // a link can ask for one with data-slide, and going back reverses
      // the direction a project page was entered from.
      let slide: string | undefined;

      document.addEventListener('astro:before-preparation', (event) => {
        const source = event.sourceElement as HTMLElement | undefined;
        const column = document.documentElement.dataset.column;
        slide = source?.dataset.slide;
        if (!slide && column && event.direction === 'back') {
          slide = column === 'film' ? 'right' : 'left';
        }
        if (slide) document.documentElement.dataset.slide = slide;
        else delete document.documentElement.dataset.slide;
      });

      document.addEventListener('astro:before-swap', (event) => {
        if (slide) event.newDocument.documentElement.dataset.slide = slide;
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--paper);
    color: var(--ink);
  }

  .skip:focus {
    top: 1rem;
  }
</style>
